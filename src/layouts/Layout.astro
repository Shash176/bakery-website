---
import "../styles/global.css";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;

const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}images/og-image.png`, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const DAY_ORDER = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

/** Expands "Monday – Saturday" or "Sunday" into ["Monday", ...] for schema.org's DayOfWeek. */
function expandDayRange(daysLabel: string): string[] {
  const parts = daysLabel.split(/[–-]/).map((p) => p.trim());
  const start = DAY_ORDER.indexOf(parts[0]);
  const end = DAY_ORDER.indexOf(parts[1] ?? parts[0]);
  if (start === -1 || end === -1) return [daysLabel];
  const days: string[] = [];
  for (let i = start; i <= end; i++) days.push(DAY_ORDER[i]);
  return days;
}

/** Converts "9:00 AM" -> "09:00" (24-hour, as schema.org expects). */
function to24Hour(time12h: string): string {
  const match = time12h.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
  if (!match) return time12h.trim();
  let [, hourStr, minute, meridiem] = match;
  let hour = parseInt(hourStr, 10) % 12;
  if (meridiem.toUpperCase() === "PM") hour += 12;
  return `${String(hour).padStart(2, "0")}:${minute}`;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: site.name,
  description: site.description,
  image: ogImage,
  telephone: site.phoneDial,
  email: site.email,
  priceRange: "₹₹",
  address: {
    "@type": "PostalAddress",
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.pincode,
    addressCountry: "IN",
  },
  openingHoursSpecification: site.hours.map((h) => {
    const [opensRaw, closesRaw] = h.time.split("–").map((t) => t.trim());
    return {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: expandDayRange(h.days),
      opens: to24Hour(opensRaw),
      closes: to24Hour(closesRaw),
    };
  }),
  sameAs: Object.values(site.social),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: warm serif for headings, clean sans-serif for body -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Nunito+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1000;
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
    background: var(--color-brown-900);
    color: #fff;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
  }
</style>
