---
import slides from "../data/slides.json";

const base = import.meta.env.BASE_URL;
---

<section
  class="hero-slider"
  id="hero-slider"
  aria-roledescription="carousel"
  aria-label="Featured bakery highlights"
>
  <div class="slider-track" id="slider-track">
    {
      slides.map((slide, index) => (
        <div
          class="slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <img
            src={`${base}${slide.image.replace(/^\//, "")}`}
            alt=""
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
          />
          <div class="slide-overlay">
            <div class="slide-copy">
              <h1>{slide.heading}</h1>
              <p>{slide.subheading}</p>
              {slide.buttonText && slide.buttonLink && (
                <a class="btn btn-primary" href={slide.buttonLink}>
                  {slide.buttonText}
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <button type="button" class="slider-arrow slider-arrow--prev" id="slider-prev">
    <span aria-hidden="true">&#8249;</span>
    <span class="visually-hidden">Previous slide</span>
  </button>
  <button type="button" class="slider-arrow slider-arrow--next" id="slider-next">
    <span aria-hidden="true">&#8250;</span>
    <span class="visually-hidden">Next slide</span>
  </button>

  <div class="slider-dots" id="slider-dots" role="tablist" aria-label="Choose slide">
    {
      slides.map((_, index) => (
        <button
          type="button"
          class="slider-dot"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-label={`Go to slide ${index + 1}`}
          data-index={index}
        />
      ))
    }
  </div>
</section>

<style>
  .hero-slider {
    position: relative;
    overflow: hidden;
    height: min(78vh, 640px);
    min-height: 420px;
    background: var(--color-brown-900);
    touch-action: pan-y;
  }

  .slider-track {
    display: flex;
    height: 100%;
    transition: transform 500ms ease;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, rgba(62, 39, 35, 0.72) 0%, rgba(62, 39, 35, 0.35) 55%, rgba(62, 39, 35, 0.15) 100%);
  }

  .slide-copy {
    max-width: 560px;
    padding: 0 1.75rem;
    color: #fff;
  }

  .slide-copy h1 {
    color: #fff;
  }

  .slide-copy p {
    font-size: 1.05rem;
    opacity: 0.92;
    margin-bottom: 1.5rem;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-brown-900);
    font-size: 1.6rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--transition);
  }

  .slider-arrow:hover {
    background: #fff;
  }

  .slider-arrow--prev {
    left: 1rem;
  }

  .slider-arrow--next {
    right: 1rem;
  }

  .slider-dots {
    position: absolute;
    bottom: 1.25rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: transparent;
    padding: 0;
    cursor: pointer;
    opacity: 0.75;
  }

  .slider-dot[aria-selected="true"] {
    background: #fff;
    opacity: 1;
  }

  @media (max-width: 600px) {
    .slide-copy {
      max-width: 90%;
    }
    .slider-arrow {
      width: 36px;
      height: 36px;
      font-size: 1.3rem;
    }
  }
</style>

<script>
  class HeroSlider {
    private track: HTMLElement;
    private slides: HTMLElement[];
    private dots: HTMLElement[];
    private prevBtn: HTMLElement | null;
    private nextBtn: HTMLElement | null;
    private index = 0;
    private timer: number | undefined;
    private readonly intervalMs = 5500;
    private reducedMotion: boolean;
    private touchStartX = 0;
    private touchDeltaX = 0;

    constructor(root: HTMLElement) {
      this.track = root.querySelector("#slider-track") as HTMLElement;
      this.slides = Array.from(root.querySelectorAll(".slide"));
      this.dots = Array.from(root.querySelectorAll(".slider-dot"));
      this.prevBtn = root.querySelector("#slider-prev");
      this.nextBtn = root.querySelector("#slider-next");
      this.reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      this.prevBtn?.addEventListener("click", () => this.go(this.index - 1));
      this.nextBtn?.addEventListener("click", () => this.go(this.index + 1));
      this.dots.forEach((dot, i) => dot.addEventListener("click", () => this.go(i)));

      root.addEventListener("mouseenter", () => this.stop());
      root.addEventListener("mouseleave", () => this.start());
      root.addEventListener("focusin", () => this.stop());
      root.addEventListener("focusout", () => this.start());

      this.track.addEventListener("touchstart", (e) => this.onTouchStart(e), { passive: true });
      this.track.addEventListener("touchmove", (e) => this.onTouchMove(e), { passive: true });
      this.track.addEventListener("touchend", () => this.onTouchEnd());

      this.render();
      this.start();
    }

    onTouchStart(e: TouchEvent) {
      this.touchStartX = e.touches[0].clientX;
      this.touchDeltaX = 0;
      this.stop();
    }

    onTouchMove(e: TouchEvent) {
      this.touchDeltaX = e.touches[0].clientX - this.touchStartX;
    }

    onTouchEnd() {
      if (Math.abs(this.touchDeltaX) > 50) {
        this.go(this.index + (this.touchDeltaX < 0 ? 1 : -1));
      }
      this.start();
    }

    go(nextIndex: number) {
      const total = this.slides.length;
      this.index = (nextIndex + total) % total;
      this.render();
    }

    render() {
      this.track.style.transform = `translateX(-${this.index * 100}%)`;
      this.slides.forEach((slide, i) => {
        slide.setAttribute("aria-hidden", String(i !== this.index));
      });
      this.dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", String(i === this.index));
      });
    }

    start() {
      if (this.reducedMotion) return;
      this.stop();
      this.timer = window.setInterval(() => this.go(this.index + 1), this.intervalMs);
    }

    stop() {
      if (this.timer) {
        window.clearInterval(this.timer);
        this.timer = undefined;
      }
    }
  }

  const sliderRoot = document.getElementById("hero-slider");
  if (sliderRoot) {
    new HeroSlider(sliderRoot);
  }
</script>
