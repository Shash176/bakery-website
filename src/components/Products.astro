---
import products from "../data/products.json";
import site from "../data/site.json";

const base = import.meta.env.BASE_URL;
const categories = ["All", ...new Set(products.map((p) => p.category))];
---

<section class="section section--alt" id="products">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Our Menu</span>
      <h2>Fresh From The Oven</h2>
      <p>Prices are per the unit shown. All items are baked fresh — ask us about custom orders.</p>
    </div>

    <div class="filter-bar" id="filter-bar" role="group" aria-label="Filter products by category">
      {
        categories.map((category, i) => (
          <button
            type="button"
            class="filter-btn"
            data-category={category}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {category}
          </button>
        ))
      }
    </div>

    <div class="product-grid" id="product-grid">
      {
        products.map((product) => (
          <article class="product-card card" data-category={product.category}>
            <div class="product-image">
              <img
                src={`${base}${product.image.replace(/^\//, "")}`}
                alt={product.name}
                loading="lazy"
                width="600"
                height="450"
              />
              {!product.available && <span class="badge-unavailable">Currently unavailable</span>}
            </div>
            <div class="product-body">
              <h3>{product.name}</h3>
              <p class="product-desc">{product.description}</p>
              <div class="product-footer">
                <span class="product-price">
                  {site.currencySymbol}{product.price} <span class="unit">{product.unit}</span>
                </span>
                <button
                  type="button"
                  class="btn btn-sm btn-primary order-this-btn"
                  data-product-id={product.id}
                  disabled={!product.available}
                >
                  {product.available ? "Order this" : "Unavailable"}
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="no-results" id="no-results" hidden>No items in this category right now — check back soon!</p>
  </div>
</section>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-brown-700);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .filter-btn:hover {
    border-color: var(--color-accent);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--color-brown-900);
    border-color: var(--color-brown-900);
    color: #fff;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-unavailable {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-brown-900);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .product-body {
    padding: 1.1rem 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    flex: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .product-price {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-brown-900);
    font-size: 1.1rem;
  }

  .product-price .unit {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .no-results {
    text-align: center;
    color: var(--color-text-muted);
    margin-top: 2rem;
  }
</style>

<script>
  const filterBar = document.getElementById("filter-bar");
  const grid = document.getElementById("product-grid");
  const noResults = document.getElementById("no-results");

  if (filterBar && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".product-card"));
    const buttons = Array.from(filterBar.querySelectorAll<HTMLButtonElement>(".filter-btn"));

    filterBar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
      if (!btn) return;
      const category = btn.dataset.category;

      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));

      let visibleCount = 0;
      cards.forEach((card) => {
        const match = category === "All" || card.dataset.category === category;
        card.hidden = !match;
        if (match) visibleCount++;
      });

      if (noResults) noResults.hidden = visibleCount !== 0;
    });
  }

  // "Order this" -> add straight to the order form's cart and scroll to it
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".order-this-btn");
    if (!btn || btn.disabled) return;

    const productId = btn.dataset.productId;
    const orderSection = document.getElementById("order");

    if (productId) {
      window.dispatchEvent(new CustomEvent("order:add-product", { detail: { productId } }));
    }

    orderSection?.scrollIntoView({ behavior: "smooth", block: "start" });

    window.setTimeout(() => {
      const nameField = document.getElementById("order-name");
      nameField?.focus();
    }, 450);
  });
</script>
