---
import products from "../data/products.json";
import site from "../data/site.json";

const availableProducts = products.filter((p) => p.available);
---

<section class="section" id="order">
  <div class="container order-grid">
    <div class="section-head order-head">
      <span class="section-eyebrow">Place An Order</span>
      <h2>Order Online</h2>
      <p>
        Add one or more products to your order, then send it to us by WhatsApp or email.
        Payment and delivery/pickup details are arranged directly with the bakery.
      </p>
    </div>

    <div class="add-product-row card">
      <div class="form-field">
        <label for="order-product">Product</label>
        <select id="order-product">
          <option value="" disabled selected>Choose a product…</option>
          {
            availableProducts.map((product) => (
              <option
                value={product.id}
                data-name={product.name}
                data-price={product.price}
                data-unit={product.unit}
              >
                {product.name} — {site.currencySymbol}{product.price} {product.unit}
              </option>
            ))
          }
        </select>
      </div>

      <div class="form-field quantity-field">
        <label for="order-quantity">Quantity</label>
        <input type="number" id="order-quantity" min="1" step="1" value="1" />
      </div>

      <button type="button" class="btn btn-primary" id="add-to-cart-btn">Add to Cart</button>
    </div>
    <p class="field-error" id="error-add"></p>

    <div class="cart card" id="cart-section" aria-live="polite">
      <h3>Your Order</h3>
      <p class="cart-empty" id="cart-empty">Your cart is empty — add a product above.</p>
      <ul class="cart-list" id="cart-list"></ul>
      <div class="cart-total" id="cart-total" hidden>
        <span>Total</span>
        <strong id="cart-total-amount"></strong>
      </div>
    </div>

    <form id="order-form" class="order-form card" novalidate data-whatsapp-number={site.whatsappNumber} data-access-key={site.web3formsAccessKey} data-bakery-name={site.name}>
      <!-- Honeypot: hidden from real users, bots tend to fill every field -->
      <div class="honeypot-field" aria-hidden="true">
        <label for="order-company">Company</label>
        <input type="text" id="order-company" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-field">
        <label for="order-name">Your name</label>
        <input type="text" id="order-name" name="name" autocomplete="name" required />
        <p class="field-error" id="error-name"></p>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="order-phone">Phone number</label>
          <input
            type="tel"
            id="order-phone"
            name="phone"
            inputmode="numeric"
            autocomplete="tel"
            placeholder="98765 43210"
            required
          />
          <p class="hint">10-digit Indian mobile number, starting with 6–9.</p>
          <p class="field-error" id="error-phone"></p>
        </div>

        <div class="form-field">
          <label for="order-date">Preferred pickup / delivery date</label>
          <input type="date" id="order-date" name="preferredDate" />
          <p class="hint">Optional — leave blank if you're not sure yet.</p>
          <p class="field-error" id="error-date"></p>
        </div>
      </div>

      <div class="form-field">
        <label for="order-notes">Notes <span class="hint">(optional)</span></label>
        <textarea id="order-notes" name="notes" rows="3" placeholder="E.g. eggless, write 'Happy Birthday Riya' on the cake…"></textarea>
      </div>

      <p class="field-error" id="error-cart"></p>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submit-order-btn">Submit Order</button>
        <button type="button" class="btn btn-whatsapp" id="whatsapp-order-btn">
          <span aria-hidden="true">💬</span> Send Order on WhatsApp
        </button>
      </div>

      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      <p class="payment-note">
        Payment and delivery/pickup are arranged directly with {site.name} once we confirm your order.
      </p>
    </form>
  </div>
</section>

<style>
  .order-grid {
    max-width: 680px;
  }

  .order-head {
    margin-bottom: 2rem;
  }

  .add-product-row {
    display: grid;
    grid-template-columns: 1fr 120px auto;
    gap: 1rem;
    align-items: end;
    padding: 1.5rem;
  }

  .quantity-field input {
    text-align: center;
  }

  #error-add,
  #error-cart {
    margin: 0.4rem 0 1.25rem;
  }

  .cart {
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .cart h3 {
    margin-bottom: 1rem;
  }

  .cart-empty {
    color: var(--color-text-muted);
    margin: 0;
  }

  .cart-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-item-name {
    font-weight: 700;
    color: var(--color-brown-900);
  }

  .cart-item-unit-price {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .qty-btn {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }

  .qty-btn:hover {
    border-color: var(--color-accent);
  }

  .cart-item-qty-value {
    min-width: 1.6em;
    text-align: center;
    font-weight: 700;
  }

  .cart-item-line-total {
    min-width: 4.5em;
    text-align: right;
    font-weight: 700;
    color: var(--color-brown-900);
  }

  .cart-item-remove {
    background: transparent;
    border: none;
    color: var(--color-error);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.3rem;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-brown-900);
  }

  .order-form {
    padding: 2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }

  .form-status {
    margin-top: 1rem;
    font-weight: 700;
    min-height: 1.2em;
  }

  .form-status[data-state="success"] {
    color: var(--color-success);
  }

  .form-status[data-state="error"] {
    color: var(--color-error);
  }

  .form-status[data-state="demo"] {
    color: var(--color-accent-dark);
  }

  .payment-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .order-form,
    .cart,
    .add-product-row {
      padding: 1.25rem;
    }
    .add-product-row {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  interface CartItem {
    id: string;
    name: string;
    price: number;
    unit: string;
    quantity: number;
  }

  const currencySymbol = "₹";
  const cart: CartItem[] = [];

  const productSelect = document.getElementById("order-product") as HTMLSelectElement;
  const quantityInput = document.getElementById("order-quantity") as HTMLInputElement;
  const addToCartBtn = document.getElementById("add-to-cart-btn") as HTMLButtonElement;
  const errorAdd = document.getElementById("error-add") as HTMLParagraphElement;
  const errorCart = document.getElementById("error-cart") as HTMLParagraphElement;

  const cartEmpty = document.getElementById("cart-empty") as HTMLParagraphElement;
  const cartList = document.getElementById("cart-list") as HTMLUListElement;
  const cartTotalRow = document.getElementById("cart-total") as HTMLDivElement;
  const cartTotalAmount = document.getElementById("cart-total-amount") as HTMLElement;

  function formatMoney(amount: number): string {
    return `${currencySymbol}${amount.toLocaleString("en-IN")}`;
  }

  function renderCart() {
    cartList.innerHTML = "";
    const hasItems = cart.length > 0;
    cartEmpty.hidden = hasItems;
    cartTotalRow.hidden = !hasItems;

    let total = 0;

    cart.forEach((item) => {
      const lineTotal = item.price * item.quantity;
      total += lineTotal;

      const li = document.createElement("li");
      li.className = "cart-item";
      li.dataset.id = item.id;
      li.innerHTML = `
        <div class="cart-item-info">
          <span class="cart-item-name">${item.name}</span>
          <span class="cart-item-unit-price">${formatMoney(item.price)} ${item.unit}</span>
        </div>
        <div class="cart-item-qty">
          <button type="button" class="qty-btn" data-action="decrement" aria-label="Decrease quantity of ${item.name}">−</button>
          <span class="cart-item-qty-value">${item.quantity}</span>
          <button type="button" class="qty-btn" data-action="increment" aria-label="Increase quantity of ${item.name}">+</button>
        </div>
        <span class="cart-item-line-total">${formatMoney(lineTotal)}</span>
        <button type="button" class="cart-item-remove" aria-label="Remove ${item.name} from cart">×</button>
      `;
      cartList.appendChild(li);
    });

    cartTotalAmount.textContent = formatMoney(total);
  }

  function addToCart(productId: string, quantity: number) {
    const option = Array.from(productSelect.options).find((o) => o.value === productId);
    if (!option) return;

    const name = option.dataset.name || option.textContent || productId;
    const price = Number(option.dataset.price || 0);
    const unit = option.dataset.unit || "";

    const existing = cart.find((item) => item.id === productId);
    if (existing) {
      existing.quantity += quantity;
    } else {
      cart.push({ id: productId, name, price, unit, quantity });
    }

    errorCart.textContent = "";
    renderCart();
  }

  addToCartBtn.addEventListener("click", () => {
    errorAdd.textContent = "";

    if (!productSelect.value) {
      errorAdd.textContent = "Please choose a product first.";
      return;
    }

    const qty = Number(quantityInput.value);
    if (!quantityInput.value || qty < 1 || !Number.isInteger(qty)) {
      errorAdd.textContent = "Enter a quantity of at least 1.";
      return;
    }

    addToCart(productSelect.value, qty);
    productSelect.value = "";
    quantityInput.value = "1";
    productSelect.focus();
  });

  cartList.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const item = target.closest<HTMLLIElement>(".cart-item");
    if (!item || !item.dataset.id) return;
    const cartItem = cart.find((c) => c.id === item.dataset.id);
    if (!cartItem) return;

    if (target.matches(".cart-item-remove")) {
      const index = cart.indexOf(cartItem);
      cart.splice(index, 1);
      renderCart();
      return;
    }

    const action = target.closest<HTMLButtonElement>(".qty-btn")?.dataset.action;
    if (action === "increment") {
      cartItem.quantity += 1;
      renderCart();
    } else if (action === "decrement") {
      cartItem.quantity -= 1;
      if (cartItem.quantity <= 0) {
        const index = cart.indexOf(cartItem);
        cart.splice(index, 1);
      }
      renderCart();
    }
  });

  // Let product cards' "Order this" buttons add straight to the cart.
  window.addEventListener("order:add-product", (e) => {
    const detail = (e as CustomEvent<{ productId: string }>).detail;
    if (detail?.productId) addToCart(detail.productId, 1);
  });

  renderCart();

  // --- Customer details + send ---

  const form = document.getElementById("order-form") as HTMLFormElement;
  const whatsappNumber = form.dataset.whatsappNumber || "";
  const accessKey = form.dataset.accessKey || "";
  const bakeryName = form.dataset.bakeryName || "";

  const dateInput = document.getElementById("order-date") as HTMLInputElement;
  const nameInput = document.getElementById("order-name") as HTMLInputElement;
  const phoneInput = document.getElementById("order-phone") as HTMLInputElement;
  const notesInput = document.getElementById("order-notes") as HTMLTextAreaElement;
  const whatsappBtn = document.getElementById("whatsapp-order-btn") as HTMLButtonElement;
  const submitBtn = document.getElementById("submit-order-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("form-status") as HTMLParagraphElement;

  // Date cannot be in the past — computed client-side so it's always "today", not the build date.
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const todayStr = today.toISOString().slice(0, 10);
  dateInput.min = todayStr;

  const PHONE_REGEX = /^[6-9]\d{9}$/;

  function setFieldError(fieldId: string, message: string) {
    const errorEl = document.getElementById(`error-${fieldId}`);
    if (errorEl) errorEl.textContent = message;
  }

  function clearErrors() {
    ["cart", "name", "phone", "date"].forEach((f) => setFieldError(f, ""));
  }

  function normalizedPhone(): string {
    return phoneInput.value.replace(/\D/g, "").slice(-10);
  }

  function validate(): boolean {
    clearErrors();
    let valid = true;

    if (cart.length === 0) {
      setFieldError("cart", "Add at least one product to your order.");
      valid = false;
    }

    if (!nameInput.value.trim()) {
      setFieldError("name", "Please tell us your name.");
      valid = false;
    }

    if (!PHONE_REGEX.test(normalizedPhone())) {
      setFieldError("phone", "Enter a valid 10-digit mobile number starting with 6–9.");
      valid = false;
    }

    if (dateInput.value && dateInput.value < todayStr) {
      setFieldError("date", "Please choose today or a future date.");
      valid = false;
    }

    return valid;
  }

  function cartTotal(): number {
    return cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  }

  function getOrderDetails() {
    return {
      name: nameInput.value.trim(),
      phone: normalizedPhone(),
      date: dateInput.value || "Not specified",
      notes: notesInput.value.trim() || "None",
    };
  }

  function setStatus(message: string, state: "success" | "error" | "demo" | "") {
    statusEl.textContent = message;
    if (state) {
      statusEl.setAttribute("data-state", state);
    } else {
      statusEl.removeAttribute("data-state");
    }
  }

  function resetOrder() {
    cart.length = 0;
    renderCart();
    form.reset();
    dateInput.min = todayStr;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    setStatus("", "");

    // Honeypot check — if filled, silently drop (looks like a bot).
    const honeypot = document.getElementById("order-company") as HTMLInputElement;
    if (honeypot && honeypot.value) {
      setStatus("Thanks! Your order has been received.", "success");
      resetOrder();
      return;
    }

    if (!validate()) {
      setStatus("Please fix the highlighted fields.", "error");
      return;
    }

    const order = getOrderDetails();

    if (!accessKey) {
      setStatus("Demo mode — order not sent. Add a Web3Forms access key to enable real submissions.", "demo");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";

    const itemsSummary = cart.map((item) => `${item.name} x${item.quantity}`).join(", ");
    const totalQty = cart.reduce((sum, item) => sum + item.quantity, 0);
    const subject =
      cart.length === 1
        ? `New order: ${cart[0].quantity} × ${cart[0].name} — ${order.name}`
        : `New order: ${totalQty} items (${cart.length} products) — ${order.name}`;

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: accessKey,
          subject,
          from_name: order.name,
          "Order Items": itemsSummary,
          "Order Total": `₹${cartTotal().toLocaleString("en-IN")}`,
          "Customer Name": order.name,
          Phone: order.phone,
          "Preferred Date": order.date,
          Notes: order.notes,
        }),
      });

      const result = await response.json();

      if (result.success) {
        setStatus("Thank you! Your order has been sent — we'll call to confirm shortly.", "success");
        resetOrder();
      } else {
        setStatus("Something went wrong sending your order. Please try WhatsApp instead.", "error");
      }
    } catch {
      setStatus("Network error — please try again or use the WhatsApp button below.", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Order";
    }
  });

  whatsappBtn.addEventListener("click", () => {
    setStatus("", "");
    if (!validate()) {
      setStatus("Please fix the highlighted fields before messaging us.", "error");
      return;
    }

    const order = getOrderDetails();
    const lines = [`Hi ${bakeryName}! I'd like to place an order:`, ""];

    cart.forEach((item) => {
      lines.push(`${item.name} quantity ${item.quantity}`);
    });

    lines.push("", `Total: ₹${cartTotal().toLocaleString("en-IN")}`, "");
    lines.push(`Ordered by: ${order.name}`);
    lines.push(`Phone: ${order.phone}`);
    if (order.date !== "Not specified") lines.push(`Preferred date: ${order.date}`);
    if (order.notes !== "None") lines.push(`Notes: ${order.notes}`);

    const text = encodeURIComponent(lines.join("\n"));
    const url = `https://wa.me/${whatsappNumber}?text=${text}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>
